{
  "expo": {
    "name": "HabitForge",
    "slug": "HabitForge",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "habitforge",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#04060C",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#04060C"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#04060C"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.kavyan123.HabitForge"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      "expo-secure-store",
      "expo-background-task",
      [
        "expo-image-picker",
        {
          "photosPermission": "HabitForge uses your photos for reward icons."
        }
      ]
    ],
    "updates": {
      "url": "https://u.expo.dev/deda73af-f547-4c7e-85c4-8c505374d462",
      "enabled": true,
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "deda73af-f547-4c7e-85c4-8c505374d462"
      }
    }
  }
}
